{"id": "bang_B", "name": "Bảng B", "level": "Lớp 4-5", "totalQuestions": 50, "parts": [{"id": 1, "name": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "questions": [{"id": 1, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Shopping for healthy food.", "question": "Tim is at the supermarket looking for healthy food. He wants to buy some fresh __________ to make a green salad.", "options": [{"key": "A", "text": "cookies"}, {"key": "B", "text": "vegetables"}, {"key": "C", "text": "candies"}, {"key": "D", "text": "sausages"}]}, {"id": 2, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Carrying a heavy backpack.", "question": "Sarah's backpack is very heavy with books today. She can hardly __________ her heavy backpack upstairs.", "options": [{"key": "A", "text": "fly"}, {"key": "B", "text": "carry"}, {"key": "C", "text": "jump"}, {"key": "D", "text": "throw"}]}, {"id": 3, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Planning a trip to the countryside.", "question": "We are going to stay at a small farm and feed the __________ in the morning.", "options": [{"key": "A", "text": "traffic"}, {"key": "B", "text": "animals"}, {"key": "C", "text": "machines"}, {"key": "D", "text": "buildings"}]}, {"id": 4, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "In the science lab.", "question": "You must wear special safety __________ to protect your eyes in the science lab.", "options": [{"key": "A", "text": "gloves"}, {"key": "B", "text": "boots"}, {"key": "C", "text": "goggles"}, {"key": "D", "text": "scarves"}]}, {"id": 5, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Feeling unwell at school.", "question": "My head hurts and I have a high temperature. I think I have a __________.", "options": [{"key": "A", "text": "fever"}, {"key": "B", "text": "toothache"}, {"key": "C", "text": "cough"}, {"key": "D", "text": "stomachache"}]}, {"id": 6, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Describing a personality trait.", "question": "Ben always shares his toys and snacks with his classmates. He is very __________.", "options": [{"key": "A", "text": "greedy"}, {"key": "B", "text": "generous"}, {"key": "C", "text": "lazy"}, {"key": "D", "text": "shy"}]}, {"id": 7, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Preparing for a rainy day.", "question": "Look at those dark clouds! Don't forget to take your __________ with you.", "options": [{"key": "A", "text": "raincoat"}, {"key": "B", "text": "swimsuit"}, {"key": "C", "text": "sunglasses"}, {"key": "D", "text": "shorts"}]}, {"id": 8, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At an amusement park.", "question": "The children were so __________ when they rode the roller coaster.", "options": [{"key": "A", "text": "bored"}, {"key": "B", "text": "excited"}, {"key": "C", "text": "sleepy"}, {"key": "D", "text": "calm"}]}, {"id": 9, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "In the school library.", "question": "Please return all borrowed books before the __________.", "options": [{"key": "A", "text": "due date"}, {"key": "B", "text": "holiday"}, {"key": "C", "text": "weekend"}, {"key": "D", "text": "lesson"}]}, {"id": 10, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Talking about environmental actions.", "question": "We should __________ plastic bottles instead of throwing them into the trash.", "options": [{"key": "A", "text": "burn"}, {"key": "B", "text": "recycle"}, {"key": "C", "text": "waste"}, {"key": "D", "text": "drop"}]}, {"id": 11, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At a restaurant.", "question": "The waiter brought us a __________ so we could choose what to eat for dinner.", "options": [{"key": "A", "text": "ticket"}, {"key": "B", "text": "menu"}, {"key": "C", "text": "receipt"}, {"key": "D", "text": "letter"}]}, {"id": 12, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Describing geography.", "question": "An island is a piece of land that is completely surrounded by __________.", "options": [{"key": "A", "text": "trees"}, {"key": "B", "text": "water"}, {"key": "C", "text": "mountains"}, {"key": "D", "text": "sand"}]}, {"id": 13, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Hobby and leisure.", "question": "Linh spends two hours every afternoon practicing the __________ to play at the concert.", "options": [{"key": "A", "text": "violin"}, {"key": "B", "text": "camera"}, {"key": "C", "text": "bicycle"}, {"key": "D", "text": "paintbrush"}]}, {"id": 14, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Celebrating an achievement.", "question": "The teacher gave Peter a gold __________ because he won the running race.", "options": [{"key": "A", "text": "key"}, {"key": "B", "text": "medal"}, {"key": "C", "text": "coin"}, {"key": "D", "text": "stamp"}]}, {"id": 15, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "In a grocery store.", "question": "How much does a __________ of chocolate cost?", "options": [{"key": "A", "text": "loaf"}, {"key": "B", "text": "bar"}, {"key": "C", "text": "slice"}, {"key": "D", "text": "can"}]}, {"id": 16, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Visiting a museum.", "question": "The guide asked us not to touch the ancient __________ on display.", "options": [{"key": "A", "text": "statues"}, {"key": "B", "text": "shadows"}, {"key": "C", "text": "crowds"}, {"key": "D", "text": "signals"}]}, {"id": 17, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Talking about future plans.", "question": "When I grow up, I want to become an __________ to build modern bridges.", "options": [{"key": "A", "text": "actor"}, {"key": "B", "text": "engineer"}, {"key": "C", "text": "artist"}, {"key": "D", "text": "astronaut"}]}, {"id": 18, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Weather conditions.", "question": "The thick __________ made it very difficult for drivers to see the road clearly.", "options": [{"key": "A", "text": "fog"}, {"key": "B", "text": "breeze"}, {"key": "C", "text": "sunshine"}, {"key": "D", "text": "lightning"}]}, {"id": 19, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At the airport.", "question": "Make sure your luggage has a name __________ on it so it won't get lost.", "options": [{"key": "A", "text": "mark"}, {"key": "B", "text": "tag"}, {"key": "C", "text": "stamp"}, {"key": "D", "text": "sign"}]}, {"id": 20, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Time expression.", "question": "A period of ten years is called a __________.", "options": [{"key": "A", "text": "century"}, {"key": "B", "text": "decade"}, {"key": "C", "text": "millennium"}, {"key": "D", "text": "fortnight"}]}]}, {"id": 2, "name": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "questions": [{"id": 21, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Comparing speed.", "question": "A rabbit moves __________ than a turtle.", "options": [{"key": "A", "text": "fast"}, {"key": "B", "text": "faster"}, {"key": "C", "text": "fastest"}, {"key": "D", "text": "more fast"}]}, {"id": 22, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about yesterday's activity.", "question": "Because it rained yesterday afternoon, we __________ football in the park.", "options": [{"key": "A", "text": "don't play"}, {"key": "B", "text": "didn't play"}, {"key": "C", "text": "haven't played"}, {"key": "D", "text": "won't play"}]}, {"id": 23, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Describing a habit.", "question": "My brother __________ goes to bed late, so he always feels tired in the morning.", "options": [{"key": "A", "text": "always"}, {"key": "B", "text": "never"}, {"key": "C", "text": "seldom"}, {"key": "D", "text": "rarely"}]}, {"id": 24, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Making weather-based plans.", "question": "If the weather __________ fine tomorrow, my family will go camping in Da Lat.", "options": [{"key": "A", "text": "is"}, {"key": "B", "text": "will be"}, {"key": "C", "text": "was"}, {"key": "D", "text": "are"}]}, {"id": 25, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Past continuous narration.", "question": "While we __________ for the school bus, it suddenly started to snow heavily.", "options": [{"key": "A", "text": "wait"}, {"key": "B", "text": "were waiting"}, {"key": "C", "text": "are waiting"}, {"key": "D", "text": "waited"}]}, {"id": 26, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Superlative form.", "question": "Mount Everest is the __________ mountain in the world.", "options": [{"key": "A", "text": "high"}, {"key": "B", "text": "higher"}, {"key": "C", "text": "highest"}, {"key": "D", "text": "most high"}]}, {"id": 27, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Relative pronoun for places.", "question": "This is the park __________ we played soccer last Sunday.", "options": [{"key": "A", "text": "who"}, {"key": "B", "text": "which"}, {"key": "C", "text": "where"}, {"key": "D", "text": "when"}]}, {"id": 28, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Asking about past duration.", "question": "How long __________ you live in Ho Chi Minh City?", "options": [{"key": "A", "text": "do"}, {"key": "B", "text": "did"}, {"key": "C", "text": "have"}, {"key": "D", "text": "are"}]}, {"id": 29, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Indefinite pronouns.", "question": "Has __________ seen my red pencil case? I can't find it anywhere.", "options": [{"key": "A", "text": "someone"}, {"key": "B", "text": "anyone"}, {"key": "C", "text": "no one"}, {"key": "D", "text": "everyone"}]}, {"id": 30, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Modal verb for obligation.", "question": "Students __________ turn off their mobile phones during the final exam.", "options": [{"key": "A", "text": "must"}, {"key": "B", "text": "might"}, {"key": "C", "text": "could"}, {"key": "D", "text": "would"}]}, {"id": 31, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Gerund after preposition.", "question": "Mai is very interested in __________ comic books in her free time.", "options": [{"key": "A", "text": "read"}, {"key": "B", "text": "reading"}, {"key": "C", "text": "to read"}, {"key": "D", "text": "reads"}]}, {"id": 32, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Future plan with \"be going to\".", "question": "Look at those dark clouds! It __________ rain very soon.", "options": [{"key": "A", "text": "is going to"}, {"key": "B", "text": "will"}, {"key": "C", "text": "going to"}, {"key": "D", "text": "is raining"}]}, {"id": 33, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Present perfect tense.", "question": "They __________ in this town since 2018.", "options": [{"key": "A", "text": "lived"}, {"key": "B", "text": "have lived"}, {"key": "C", "text": "are living"}, {"key": "D", "text": "live"}]}, {"id": 34, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Quantity expressions.", "question": "There isn't __________ milk left in the fridge. We need to buy more.", "options": [{"key": "A", "text": "many"}, {"key": "B", "text": "much"}, {"key": "C", "text": "a few"}, {"key": "D", "text": "some"}]}, 