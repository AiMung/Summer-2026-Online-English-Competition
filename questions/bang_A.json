{"id": "bang_A", "name": "Bảng A", "level": "Lớp 1-2-3", "totalQuestions": 50, "parts": [{"id": 1, "name": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "questions": [{"id": 1, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At the zoo.", "question": "You are at the zoo. Look! The __________ has a long trunk and big ears.", "options": [{"key": "A", "text": "giraffe"}, {"key": "B", "text": "elephant"}, {"key": "C", "text": "monkey"}, {"key": "D", "text": "tiger"}]}, {"id": 2, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Getting ready to go outside on a cold day.", "question": "It is cold today. Don't forget to put on your warm __________ before going outside.", "options": [{"key": "A", "text": "shirt"}, {"key": "B", "text": "jacket"}, {"key": "C", "text": "hat"}, {"key": "D", "text": "paints"}]}, {"id": 3, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Helping in the kitchen.", "question": "Mom is cooking in the kitchen. She says, \"Can you give me a glass of __________, please?\"", "options": [{"key": "A", "text": "bread"}, {"key": "B", "text": "rice"}, {"key": "C", "text": "water"}, {"key": "D", "text": "apple"}]}, {"id": 4, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Getting ready to draw.", "question": "I have my pencils and paper. I am ready to __________ a picture.", "options": [{"key": "A", "text": "listen"}, {"key": "B", "text": "draw"}, {"key": "C", "text": "hang"}, {"key": "D", "text": "run"}]}, {"id": 5, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Describing the weather.", "question": "It is a beautiful day. The __________ is shining brightly.", "options": [{"key": "A", "text": "sun"}, {"key": "B", "text": "moon"}, {"key": "C", "text": "star"}, {"key": "D", "text": "cloud"}]}, {"id": 6, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "In the classroom.", "question": "The teacher is writing on the board with a piece of white __________.", "options": [{"key": "A", "text": "paper"}, {"key": "B", "text": "chalk"}, {"key": "C", "text": "eraser"}, {"key": "D", "text": "ruler"}]}, {"id": 7, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Playing with a puppy.", "question": "My puppy likes to play with a big __________.", "options": [{"key": "A", "text": "bone"}, {"key": "B", "text": "fish"}, {"key": "C", "text": "milk"}, {"key": "D", "text": "grass"}]}, {"id": 8, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At a birthday party.", "question": "Look at the birthday __________ with seven candles on it!", "options": [{"key": "A", "text": "pizza"}, {"key": "B", "text": "cake"}, {"key": "C", "text": "soup"}, {"key": "D", "text": "burger"}]}, {"id": 9, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "After playing in the park.", "question": "After running in the park, I want to sit down and have a __________.", "options": [{"key": "A", "text": "sleep"}, {"key": "B", "text": "rest"}, {"key": "C", "text": "jump"}, {"key": "D", "text": "dance"}]}, {"id": 10, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Watching a butterfly in the garden.", "question": "A beautiful butterfly is sitting on a red __________.", "options": [{"key": "A", "text": "tree"}, {"key": "B", "text": "flower"}, {"key": "C", "text": "leaf"}, {"key": "D", "text": "rock"}]}, {"id": 11, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Morning routine.", "question": "Every morning, I use my toothbrush to __________ my teeth.", "options": [{"key": "A", "text": "wash"}, {"key": "B", "text": "brush"}, {"key": "C", "text": "comb"}, {"key": "D", "text": "paint"}]}, {"id": 12, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Opening a door.", "question": "Please turn the __________ to open the door.", "options": [{"key": "A", "text": "window"}, {"key": "B", "text": "key"}, {"key": "C", "text": "handle"}, {"key": "D", "text": "wall"}]}, {"id": 13, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Daily routine — going to school.", "question": "My brother rides his __________ to school every day.", "options": [{"key": "A", "text": "car"}, {"key": "B", "text": "bicycle"}, {"key": "C", "text": "bus"}, {"key": "D", "text": "train"}]}, {"id": 14, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Looking at fruit.", "question": "These yellow fruits are __________.", "options": [{"key": "A", "text": "apples"}, {"key": "B", "text": "bananas"}, {"key": "C", "text": "grapes"}, {"key": "D", "text": "oranges"}]}, {"id": 15, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "On a hot day.", "question": "It is very hot today, so I turn on the __________.", "options": [{"key": "A", "text": "fan"}, {"key": "B", "text": "lamp"}, {"key": "C", "text": "clock"}, {"key": "D", "text": "radio"}]}, {"id": 16, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Talking about family.", "question": "My mother's mother is my __________.", "options": [{"key": "A", "text": "aunt"}, {"key": "B", "text": "sister"}, {"key": "C", "text": "grandmother"}, {"key": "D", "text": "cousin"}]}, {"id": 17, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Getting ready for bed.", "question": "At night, I put my head on a soft __________ before I go to sleep.", "options": [{"key": "A", "text": "blanket"}, {"key": "B", "text": "pillow"}, {"key": "C", "text": "desk"}, {"key": "D", "text": "floor"}]}, {"id": 18, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "In English class.", "question": "We open our __________ to read a story in English class.", "options": [{"key": "A", "text": "bags"}, {"key": "B", "text": "books"}, {"key": "C", "text": "pens"}, {"key": "D", "text": "desks"}]}, {"id": 19, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "Talking about farm animals.", "question": "Cows give us fresh __________.", "options": [{"key": "A", "text": "water"}, {"key": "B", "text": "juice"}, {"key": "C", "text": "milk"}, {"key": "D", "text": "tea"}]}, {"id": 20, "part": 1, "partName": "PART 1: VOCABULARY IN CONTEXT (20 CÂU)", "context": "At the playground.", "question": "The children are playing on the __________ in the playground.", "options": [{"key": "A", "text": "swing"}, {"key": "B", "text": "table"}, {"key": "C", "text": "bed"}, {"key": "D", "text": "shelf"}]}]}, {"id": 2, "name": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "questions": [{"id": 21, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "In the classroom.", "question": "The teacher is talking to __________.", "options": [{"key": "A", "text": "I"}, {"key": "B", "text": "me"}, {"key": "C", "text": "my"}, {"key": "D", "text": "mine"}]}, {"id": 22, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Looking at birds in a tree.", "question": "There are two birds on the tree. __________ are red and blue.", "options": [{"key": "A", "text": "This"}, {"key": "B", "text": "That"}, {"key": "C", "text": "These"}, {"key": "D", "text": "Those"}]}, {"id": 23, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Counting toy cars.", "question": "How many cars __________ there in the box?", "options": [{"key": "A", "text": "is"}, {"key": "B", "text": "are"}, {"key": "C", "text": "am"}, {"key": "D", "text": "be"}]}, {"id": 24, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Listening to a baby.", "question": "Listen! The baby __________ in the bedroom.", "options": [{"key": "A", "text": "cry"}, {"key": "B", "text": "is crying"}, {"key": "C", "text": "cried"}, {"key": "D", "text": "cries"}]}, {"id": 25, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Describing a cat's position.", "question": "The cat is sleeping __________ the table.", "options": [{"key": "A", "text": "on"}, {"key": "B", "text": "in"}, {"key": "C", "text": "at"}, {"key": "D", "text": "behind"}]}, {"id": 26, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about animals.", "question": "A fish __________ swim, but it cannot fly.", "options": [{"key": "A", "text": "can"}, {"key": "B", "text": "must"}, {"key": "C", "text": "should"}, {"key": "D", "text": "need"}]}, {"id": 27, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "In the garden.", "question": "There are three small __________ in the garden.", "options": [{"key": "A", "text": "mouse"}, {"key": "B", "text": "mouses"}, {"key": "C", "text": "mice"}, {"key": "D", "text": "mices"}]}, {"id": 28, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about a school bag.", "question": "This is __________ new school bag.", "options": [{"key": "A", "text": "she"}, {"key": "B", "text": "her"}, {"key": "C", "text": "hers"}, {"key": "D", "text": "herself"}]}, {"id": 29, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Daily routine.", "question": "He __________ to school every morning.", "options": [{"key": "A", "text": "go"}, {"key": "B", "text": "goes"}, {"key": "C", "text": "going"}, {"key": "D", "text": "went"}]}, {"id": 30, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about a hobby.", "question": "She likes __________ with her dolls after school.", "options": [{"key": "A", "text": "play"}, {"key": "B", "text": "playing"}, {"key": "C", "text": "played"}, {"key": "D", "text": "plays"}]}, {"id": 31, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about drinks.", "question": "I __________ like drinking cold coffee.", "options": [{"key": "A", "text": "don't"}, {"key": "B", "text": "doesn't"}, {"key": "C", "text": "isn't"}, {"key": "D", "text": "aren't"}]}, {"id": 32, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Offering fruit.", "question": "Would you like an apple __________ an orange?", "options": [{"key": "A", "text": "and"}, {"key": "B", "text": "or"}, {"key": "C", "text": "but"}, {"key": "D", "text": "so"}]}, {"id": 33, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Asking about age.", "question": "How old __________ your little sister?", "options": [{"key": "A", "text": "is"}, {"key": "B", "text": "are"}, {"key": "C", "text": "am"}, {"key": "D", "text": "be"}]}, {"id": 34, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Describing shoes.", "question": "Her shoes __________ clean and white.", "options": [{"key": "A", "text": "is"}, {"key": "B", "text": "are"}, {"key": "C", "text": "am"}, {"key": "D", "text": "be"}]}, {"id": 35, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Looking for a pencil.", "question": "\"__________ is my pencil?\" \"It's under your desk.\"", "options": [{"key": "A", "text": "What"}, {"key": "B", "text": "Who"}, {"key": "C", "text": "Where"}, {"key": "D", "text": "When"}]}, {"id": 36, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Introducing a toy.", "question": "__________ is my favourite toy robot.", "options": [{"key": "A", "text": "This"}, {"key": "B", "text": "That"}, {"key": "C", "text": "These"}, {"key": "D", "text": "Those"}]}, {"id": 37, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about yesterday.", "question": "Yesterday, we __________ to the zoo.", "options": [{"key": "A", "text": "go"}, {"key": "B", "text": "went"}, {"key": "C", "text": "going"}, {"key": "D", "text": "goes"}]}, {"id": 38, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about drinking water.", "question": "How __________ water do you drink every day?", "options": [{"key": "A", "text": "many"}, {"key": "B", "text": "much"}, {"key": "C", "text": "long"}, {"key": "D", "text": "old"}]}, {"id": 39, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Talking about a father's job.", "question": "My father is a doctor. __________ works in a hospital.", "options": [{"key": "A", "text": "She"}, {"key": "B", "text": "He"}, {"key": "C", "text": "They"}, {"key": "D", "text": "It"}]}, {"id": 40, "part": 2, "partName": "PART 2: GRAMMAR & SENTENCE STRUCTURES (20 CÂU)", "context": "Asking for quiet.", "question": "Please __________ quiet. The baby is sleeping.", "options": [{"key": "A", "text": "is"}, {"key": "B", "text": "are"}, {"key": "C", "text": "be"}, {"key": "D", "text": "am"}]}]}, {"id": 3, "name": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "questions": [{"id": 41, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Receiving a gift.", "question": "Friend: \"Happy birthday! This is for you.\"", "options": [{"key": "A", "text": "You're welcome."}, {"key": "B", "text": "Thank you so much!"}, {"key": "C", "text": "Good morning."}, {"key": "D", "text": "Goodbye."}]}, {"id": 42, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Asking for permission.", "question": "Student: \"May I go out, please?\"", "options": [{"key": "A", "text": "Yes, you can."}, {"key": "B", "text": "No, I am not."}, {"key": "C", "text": "Thank you."}, {"key": "D", "text": "Good night."}]}, {"id": 43, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Apologizing.", "question": "Boy: \"I'm sorry I bumped into you.\"", "options": [{"key": "A", "text": "That's OK."}, {"key": "B", "text": "Yes, please."}, {"key": "C", "text": "You're eight years old."}, {"key": "D", "text": "Goodbye."}]}, {"id": 44, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Notice at a house entrance.", "question": "NOTICE: \"Please take off your shoes before you come in.\"", "options": [{"key": "A", "text": "Wear a hat."}, {"key": "B", "text": "Leave your shoes outside."}, {"key": "C", "text": "Wash your hands."}, {"key": "D", "text": "Open your bag."}]}, {"id": 45, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Notice in a quiet place.", "question": "NOTICE: \"Please be quiet.\"", "options": [{"key": "A", "text": "Talk quietly or stay silent"}, {"key": "B", "text": "Sing loudly."}, {"key": "C", "text": "Run fast."}, {"key": "D", "text": "Read aloud."}]}, {"id": 46, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Greeting the class.", "question": "Teacher: \"Good morning, class!\"", "options": [{"key": "A", "text": "Good night."}, {"key": "B", "text": "Good morning!"}, {"key": "C", "text": "Goodbye."}, {"key": "D", "text": "See you later."}]}, {"id": 47, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Offering help.", "question": "Tom: \"Can I help you carry this box?\"", "options": [{"key": "A", "text": "Yes, please. Thank you!"}, {"key": "B", "text": "No, I am Anna."}, {"key": "C", "text": "It is blue."}, {"key": "D", "text": "I like apples."}]}, {"id": 48, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Notice by a trash bin.", "question": "NOTICE: \"Put your rubbish here.\"", "options": [{"key": "A", "text": "Keeping books"}, {"key": "B", "text": "Throwing away rubbish"}, {"key": "C", "text": "Keeping toys"}, {"key": "D", "text": "Washing hands"}]}, {"id": 49, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Saying goodbye.", "question": "Friend: \"See you tomorrow!\"", "options": [{"key": "A", "text": "Nice to meet you."}, {"key": "B", "text": "Bye! See you!"}, {"key": "C", "text": "I am fine."}, {"key": "D", "text": "Here you are."}]}, {"id": 50, "part": 3, "partName": "PART 3: FUNCTIONAL LANGUAGE & SHORT NOTICES (10 CÂU)", "context": "Notice on a wet floor.", "question": "NOTICE: \"CAUTION! WET FLOOR\"", "options": [{"key": "A", "text": "Run quickly."}, {"key": "B", "text": "Walk carefully."}, {"key": "C", "text": "Sit down."}, {"key": "D", "text": "Dance."}]}]}]}